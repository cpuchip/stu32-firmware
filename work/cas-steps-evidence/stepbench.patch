+/* THROWAWAY (cas-steps-device's measured cost, not for the repo): casim_step paged on the S3, in the CAS arena, from
+   the calc task: each case's count, its slowest page and all its pages in microseconds, its longest page in cells, the
+   task's stack still free */
+static __attribute__((noinline)) void stepbench(void)
+{
+    static const struct { const char *name; int op; const char *eqn; } K[] = {
+        {"solve quadratic", CASIM_SOLVE, "X^2-5\xc3\x97X+6=0"},
+        {"solve sextic", CASIM_SOLVE, "(X-1)\xc3\x97(X-2)\xc3\x97(X-3)\xc3\x97(X-4)\xc3\x97(X-5)\xc3\x97(X-6)"},
+        {"solve V=IxR", CASIM_SOLVE, "V=I\xc3\x97R"},
+        {"derive product", CASIM_DERIVE, "X^3\xc3\x97SIN(X)\xc3\x97" "EXP(X)\xc3\x97LN(X)"},
+        {"derive quotient", CASIM_DERIVE, "(X^2+1)^5\xc3\x97(X-3)^4\xc3\xb7(X+2)^3"},
+        {"integrate X^2", CASIM_INTEGRATE, "X^2"},
+        {"integrate pf4", CASIM_INTEGRATE, "1\xc3\xb7((X-1)\xc3\x97(X-2)\xc3\x97(X-3)\xc3\x97(X-4))"},
+        {"integrate ATAN", CASIM_INTEGRATE, "ATAN(X)"},
+        {"integrate XATAN", CASIM_INTEGRATE, "X\xc3\x97" "ATAN(X)"},
+        {"integrate XATAN+pf", CASIM_INTEGRATE, "X\xc3\x97" "ATAN(X)+1\xc3\xb7(X^2-1)"},
+        {"integrate e^x sin", CASIM_INTEGRATE, "EXP(X)\xc3\x97SIN(X)"},
+    };
+    char out[512];
+    for (size_t k = 0; k < sizeof K / sizeof K[0]; k++)
+        for (int flags = 0; flags <= CASIM_STEPS_ONE_LINE; flags++) {
+            casim_req rq = {(casim_op)K[k].op, K[k].eqn, CASIM_MODEL_STU, K[k].op == CASIM_SOLVE && k == 2 ? 'R' - 'A' : 23,
+                            NULL, CASIM_MODEL_STU, 0, NULL};
+            casim_step_info in = {0, 0, 0, 0};
+            int64_t c0 = esp_timer_get_time();
+            casim_status st = casim_step(&rq, -1, flags, &in, out, sizeof out, ab_cas_arena, sizeof ab_cas_arena);
+            int64_t c1 = esp_timer_get_time(), worst = 0, all = 0;
+            int cells = 0;
+            for (int i = 0; i < in.count; i++) {
+                int64_t t0 = esp_timer_get_time();
+                casim_status s2 = casim_step(&rq, i, flags, &in, out, sizeof out, ab_cas_arena, sizeof ab_cas_arena);
+                int64_t dt = esp_timer_get_time() - t0;
+                all += dt, worst = dt > worst ? dt : worst;
+                int n = 0;
+                for (const char *p = out; *p; p++) n += ((unsigned char)*p & 0xC0) != 0x80;
+                if (n > cells) cells = n;
+                if (s2 != CASIM_OK && s2 != CASIM_PARTIAL) st = s2;
+            }
+            printf("stepbench: %-20s %s st %d steps %2d count %lld us page max %lld us all %lld us cells %d stack-free %u\n",
+                   K[k].name, flags ? "1L" : "TL", (int)st, in.count, (long long)(c1 - c0), (long long)worst,
+                   (long long)all, cells, (unsigned)uxTaskGetStackHighWaterMark(NULL));
+        }
+    printf("stepbench: done\n");
+}
