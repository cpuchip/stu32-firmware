     *out = c->x;
     c->x = sx;
@@ -6025,6 +6046,7 @@ static abn_status do_key(ab_calc *c, ab_op op, int arg)
         /* Clear the stack: all four registers to 0, lift disabled (UG p.2-7, p.B-5). */
         c->x = c->y = c->z = c->t = ab_real(abn_zero());
