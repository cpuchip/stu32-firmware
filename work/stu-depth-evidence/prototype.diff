     case AB_ENTER:
@@ -6044,15 +6066,19 @@ static abn_status do_key(ab_calc *c, ab_op op, int arg)
     case AB_RDN: {
         /* Roll down: Y to X, Z to Y, T to Z, X to T (UG p.2-3). */
         ab_val x = c->x;
