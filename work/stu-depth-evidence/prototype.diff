     c->sel_drop = false;
     c->sel_view = 0;
@@ -105,8 +107,20 @@ void ab_init(ab_calc *c)
 }
 
 /* The stack lifts: T is lost, Z to T, Y to Z, X to Y; X keeps its value (UG p.2-5). */
+static bool deep_on(const ab_calc *c)
+{
+    if (!c->stu || c->active || c->dhold) return false;
+    if (c->running > 0 && ab_rec_model(c) != AB_MODEL_STU) return false;
+    return true;
+}
+static int live_n(const ab_calc *c)
+{
+    for (int i = 11; i >= 0; i--) if (!c->deep[i].bare) return i + 5;
+    return 4;
+}
 static void stack_lift(ab_calc *c)
 {
+    if (deep_on(c)) { for (int i = 11; i > 0; i--) c->deep[i] = c->deep[i - 1]; c->deep[0] = c->t; }
     c->t = c->z;
     c->z = c->y;
     c->y = c->x;
@@ -118,6 +132,10 @@ static void stack_drop(ab_calc *c)
 {
     c->y = c->z;
     c->z = c->t;
+    if (deep_on(c)) {
+        int n = live_n(c);
+        if (n > 4) { c->t = c->deep[0]; for (int i = 0; i < n - 5; i++) c->deep[i] = c->deep[i + 1]; c->deep[n - 5] = bare0(); }
+    }
 }
 
