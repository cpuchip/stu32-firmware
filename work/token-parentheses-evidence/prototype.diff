+/* PROTO 105: %LOOK's frames, each vector's after its keys (screen_render, the default ui), kept by id in a file that
+   holds a %LOOK (none kept otherwise, so no other file pays for a render) */
+static int write_png(const char *path, const ls027_frame *f);
+static struct look { char *id; ls027_frame *f; } *looks;
+static int looks_n, looks_cap;
+static bool looks_on;
+
+static void looks_reset(void)
+{
+    for (int i = 0; i < looks_n; i++) free(looks[i].id), free(looks[i].f);
+    looks_n = 0;
+}
+
+static const ls027_frame *look_of(const char *id)
+{
+    for (int i = 0; i < looks_n; i++)
+        if (!strcmp(looks[i].id, id)) return looks[i].f;
+    return NULL;
+}
+
+static void look_keep(const char *id, const ab_calc *c)
+{
+    if (looks_n == looks_cap) {
+        int cap = looks_cap ? 2 * looks_cap : 64;
+        struct look *p = realloc(looks, (size_t)cap * sizeof *p);
+        if (!p) return;
+        looks = p, looks_cap = cap;
+    }
+    ls027_frame *f = malloc(sizeof *f);
+    char *copy = malloc(strlen(id) + 1);
+    if (!f || !copy) { free(f); free(copy); return; }
+    strcpy(copy, id);
+    screen_ui ui;
+    screen_ui_default(&ui);
+    screen_render(c, &ui, f);
+    looks[looks_n].id = copy, looks[looks_n].f = f, looks_n++;
+    if (getenv("AB_LOOKDIR")) {
+        char path[512];
+        snprintf(path, sizeof path, "%s/%s.png", getenv("AB_LOOKDIR"), id);
+        write_png(path, f);
+    }
+}
+
+/* PROTO 105: the PNG writer, screen_test's */
+static void be32(uint8_t *p, uint32_t v)
+{
+    p[0] = (uint8_t)(v >> 24);
+    p[1] = (uint8_t)(v >> 16);
+    p[2] = (uint8_t)(v >> 8);
+    p[3] = (uint8_t)v;
+}
+
+static int png_chunk(FILE *o, const char *type, const uint8_t *data, size_t n)
+{
+    static uint8_t buf[4 + 16384];
+    uint8_t len[4], crc[4];
+    if (n > sizeof buf - 4) return 0;
+    memcpy(buf, type, 4);
+    if (n) memcpy(buf + 4, data, n);
+    be32(len, (uint32_t)n);
+    be32(crc, ab_crc32(buf, 4 + n));
+    return fwrite(len, 1, 4, o) == 4 && fwrite(buf, 1, 4 + n, o) == 4 + n && fwrite(crc, 1, 4, o) == 4;
+}
+
+/* The frame as a PNG: greyscale, one bit a pixel (1 white), each row filter 0, the image data a
+   zlib stream of one stored deflate block, so no compressor is needed and the bytes are fixed. */
+static int write_png(const char *path, const ls027_frame *f)
+{
+    enum { ROW = 1 + LS027_ROW_BYTES, RAW = ROW * LS027_H };
+    static uint8_t z[2 + 5 + RAW + 4];
+    uint8_t hdr[13] = {0};
+    uint32_t a = 1, b = 0;
+    be32(hdr, LS027_W);
+    be32(hdr + 4, LS027_H);
+    hdr[8] = 1;                                 /* bit depth; colour type 0, the rest 0 */
+    z[0] = 0x78;                                /* zlib: deflate, 32K window, no dictionary */
+    z[1] = 0x01;
+    z[2] = 0x01;                                /* the final block, stored */
+    z[3] = (uint8_t)(RAW & 0xFF);
+    z[4] = (uint8_t)(RAW >> 8);
+    z[5] = (uint8_t)~z[3];
+    z[6] = (uint8_t)~z[4];
+    for (int y = 0; y < LS027_H; y++) {
+        uint8_t *r = z + 7 + y * ROW;
+        r[0] = 0;
+        for (int i = 0; i < LS027_ROW_BYTES; i++) {     /* the leftmost pixel in the top bit */
+            uint8_t v = f->px[y][i], o = 0;
+            for (int k = 0; k < 8; k++) o |= (uint8_t)((~v >> k & 1) << (7 - k));
+            r[1 + i] = o;
+        }
+    }
+    for (int i = 0; i < RAW; i++) {             /* Adler-32 of the raw rows */
+        a = (a + z[7 + i]) % 65521;
+        b = (b + a) % 65521;
+    }
+    be32(z + 7 + RAW, b << 16 | a);
+    FILE *o = fopen(path, "wb");
+    if (!o) return 0;
+    int ok = fwrite("\x89PNG\r\n\x1a\n", 1, 8, o) == 8 && png_chunk(o, "IHDR", hdr, sizeof hdr) &&
+             png_chunk(o, "IDAT", z, sizeof z) && png_chunk(o, "IEND", NULL, 0);
+    return fclose(o) == 0 && ok;
+}
+
+/* the pixels two frames differ in */
+static long look_diff(const ls027_frame *a, const ls027_frame *b)
+{
+    long n = 0;
+    for (int y = 0; y < LS027_H; y++)
+        for (int i = 0; i < LS027_ROW_BYTES; i++) n += __builtin_popcount((unsigned)(a->px[y][i] ^ b->px[y][i]));
+    return n;
+}
