# Waveshare ESP32-S3-Touch-LCD-4.3: 8 MB flash, 8 MB octal PSRAM (measured 2026-10-03), console
# on UART0 through the board's CH343.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# unit 051: the flash read four bits a clock (the module's quad flash). The core runs from flash through a 16 KB
# instruction cache, and its misses were most of the time: SOLVE -39%, an integral -40%, programs -25 to -31%
# (work/051). The boot log says "SPI Mode : QIO".
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# abacus #5504: the non-ISR FreeRTOS functions in flash (their ISR ones stay in IRAM, all the RGB interrupt uses):
# +7,428 B of internal heap, the largest internal block 131,072 -> 139,264, so the keyboard image (96,000 B after the
# calc stack's 32,768, one region) has ~10.5 KB spare, not ~2.3. Speed within 0.6%. 120 flash writes under the live RGB
# interrupt pass (device/standin/flashstress.txt).
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# The bounce-buffer fill (si_line) keeps drawing while the store writes flash
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
# A long SOLVE is one call (unit 016): the calc task may hold the CPU for a while
CONFIG_ESP_TASK_WDT_INIT=n
# the core's arena pool in PSRAM (main/pool_attr.h)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
