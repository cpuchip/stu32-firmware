# Rev A: ESP32-S3-WROOM-1-N16R8 (16 MB flash, 8 MB octal PSRAM; docs/hw facts section 2)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# unit 051 (abacus #5309): the module's flash read four bits a clock. The N16R8's 16 MB flash is quad SPI, inside the
# module (Espressif's WROOM datasheet v1.8, Table 1-1, p. 3). On the stand-in it made SOLVE 39% faster. Bring-up
# check: the boot log says "SPI Mode : QIO", and the store saves and loads across a reset.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# unit 059 (abacus #5989): a 32 KB instruction cache, not 16. The core runs from flash, and its misses were the time
# left after QIO: Rev A head-less SOLVE -41%, an integral -41%, the cubic at 34 digits -75%, programs -25 to -33%, the
# same answers digit for digit. SRAM0's 16 KB block becomes cache and its code moves into the shared SRAM: internal RAM
# +16,383 B static, the heap after boot 185,495 B with a largest block of 90,112 (the ceiling for any internal block).
# A 64 KB data cache was measured and gave nothing (work/059). The stand-in stays at 16 KB: its keyboard image needs
# its 128 KB region.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
# unit 061 (abacus #6106): the console on the USB-C port (USB-Serial-JTAG), the primary one. As a secondary console
# (UART0 primary, IDF's default) it printed but took no input: vfs_console.c's console_read reads the primary alone
# (IDF v5.4.2), and Rev A's UART0 is only test pads. Measured on the S3 at f9401bd: X sent over USB, no reply. With
# no host reading, a write waits at most 50 ms once and then drops (usb_serial_jtag_vfs.c), as the secondary did.
# Head-less keeps UART0 (headless.defaults), so 053's scripts run over the stand-in's CH340 unchanged.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# decision 35: PSRAM ECC on, for the module's 85 C rating (a calculator left in a car). Measured on
# the stand-in's octal R8 (5421c84): 1/16 of the PSRAM (512 KiB), +4.6% on a state load, programs
# within noise; two calculators' state still has 34x its size free.
CONFIG_SPIRAM_ECC_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# the key scan runs every millisecond (keys.h)
CONFIG_FREERTOS_HZ=1000
# the ULP-RISC-V toggles EXTCOMIN awake and in deep sleep (Sharp p.19: COM follows its rising edge)
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_RISCV=y
CONFIG_ULP_COPROC_RESERVE_MEM=4096
# a long SOLVE is one call (unit 016)
CONFIG_ESP_TASK_WDT_INIT=n
# unit 023: automatic light sleep between keys (the ticks stay 1 ms for the scan while a key is down)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
