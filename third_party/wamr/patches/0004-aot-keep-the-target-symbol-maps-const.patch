From ce4b135434e9c7b3dfb9bac62a0bfec87c12edf5 Mon Sep 17 00:00:00 2001
From: Michael Stufflebeam <cpuchip@gmail.com>
Date: Fri, 9 Oct 2026 16:26:33 +0000
Subject: [PATCH] aot: keep the target symbol maps const

Nothing writes target_sym_map: the loader only looks symbols up in it,
and x86_64 copies addresses out of it into its PLT. Declared const, it
goes to flash rodata on a microcontroller instead of internal RAM. On the
ESP32-S3 that is 1,000 bytes of DRAM for the Xtensa map.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 core/iwasm/aot/aot_loader.c             | 4 ++--
 core/iwasm/aot/aot_reloc.h              | 2 +-
 core/iwasm/aot/arch/aot_reloc_aarch64.c | 4 ++--
 core/iwasm/aot/arch/aot_reloc_arc.c     | 4 ++--
 core/iwasm/aot/arch/aot_reloc_arm.c     | 4 ++--
 core/iwasm/aot/arch/aot_reloc_dummy.c   | 2 +-
 core/iwasm/aot/arch/aot_reloc_mips.c    | 4 ++--
 core/iwasm/aot/arch/aot_reloc_riscv.c   | 4 ++--
 core/iwasm/aot/arch/aot_reloc_thumb.c   | 4 ++--
 core/iwasm/aot/arch/aot_reloc_x86_32.c  | 4 ++--
 core/iwasm/aot/arch/aot_reloc_x86_64.c  | 4 ++--
 core/iwasm/aot/arch/aot_reloc_xtensa.c  | 4 ++--
 12 files changed, 22 insertions(+), 22 deletions(-)

diff --git a/core/iwasm/aot/aot_loader.c b/core/iwasm/aot/aot_loader.c
index 121708d..b8dc48e 100644
--- a/core/iwasm/aot/aot_loader.c
+++ b/core/iwasm/aot/aot_loader.c
@@ -621,7 +621,7 @@ get_native_symbol_by_name(const char *name)
 {
     void *func = NULL;
     uint32 symnum = 0;
-    SymbolMap *sym = NULL;
+    const SymbolMap *sym = NULL;
 
     sym = get_target_symbol_map(&symnum);
 
@@ -3097,7 +3097,7 @@ static void *
 resolve_target_sym(const char *symbol, int32 *p_index)
 {
     uint32 i, num = 0;
-    SymbolMap *target_sym_map;
+    const SymbolMap *target_sym_map;
 
     if (!(target_sym_map = get_target_symbol_map(&num)))
         return NULL;
diff --git a/core/iwasm/aot/aot_reloc.h b/core/iwasm/aot/aot_reloc.h
index ed225b5..a1606fb 100644
